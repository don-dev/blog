---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/HomeBaseLayout.astro';
import PostCard from '../components/PostCard.astro';

let allPosts = await getCollection('posts');
allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<BaseLayout>
    <div class="grid-cols-1 lg:grid-cols-2 grid">
        <!-- intro -->
    </div>
    <div class="lg:grid-cols-2 grid-cols-1 grid px-3">
    </div>
</BaseLayout>
