---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import LogoGif from '../images/logo_peek.gif';
import '../styles/global.css';

const { 
  entry,
  pageTitle = 'DONDEv', 
  description = 'Portfolio of many things and a blog to comment on it',
  cover = '/open-graph.webp' 
} = Astro.props;
---

<html lang='en'>
  <head>
    <!--Global Metadata -->
    <meta charset='utf-8' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />


    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name='description' content={description} />

   <!-- Open Graph -->
   <meta name="twitter:card" content="summary_large_image">
   <meta property="og:url" content={`https://donalcasey.io/${entry?.slug || ''}`}>
   <meta property="og:type" content="article">
   <meta property="og:title" content={entry?.title || pageTitle}>
   <meta property="og:description" content={entry?.description || pageTitle}>
   <meta property="og:image" content={`https://donalcasey.io/${cover.src || cover}`}>

    <!-- Sitemap -->
    <link rel='sitemap' href='/sitemap-index.xml' />

    <title>{pageTitle}</title>

    <ViewTransitions />

<style>
        .dondev-logo {
            width: 100%;
            max-width: 350px;
            margin: 0 auto;
            display: block;
        }
        .logo-lockup {
      position: relative;
            border: 13px solid #222;
            border-radius: 106% 36%;
      overflow: visible;
    }
    .logo-lockup a {
      display: block;
    }
    .logo-orbit {
      position: absolute;
      inset: -13px;
      pointer-events: none;
    }
    .logo-orbit::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 9px;
      height: 10px;
      border-radius: 50%;
      background: #e9e4e4;
      box-shadow: 0 0 12px rgb(110, 108, 108);
      offset-path: inset(0 round 106% 36%);
      offset-distance: 0%;
      offset-rotate: 0deg;
      transform: translate(-50%, -50%);
      animation: logo-orbit 160s linear infinite;
    }
    @keyframes logo-orbit {
      to {
        offset-distance: 100%;
      }
    }
    @supports not (offset-path: inset(0 round 10px)) {
      .logo-orbit {
        animation: logo-orbit-fallback 6s linear infinite;
        transform-origin: center;
      }
      .logo-orbit::after {
        top: -5px;
        left: calc(50% - 5px);
        transform: none;
        offset-path: none;
      }
      @keyframes logo-orbit-fallback {
        to {
          transform: rotate(360deg);
        }
      }
        }
</style>
  </head>
  
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-FP1SMR8QTP"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-FP1SMR8QTP');
</script>

  <body class='mx-auto prose prose-neutral px-4 prose-img:rounded dark:prose-invert dark:bg-neutral-900 lg:max-w-screen-xl'>
        <Header />
        <div class='my-80 logo-lockup'>
        <span class='logo-orbit' aria-hidden='true'></span>
            <a class="items-center" href="/blog" alt-text="DON-DEV"><img class='dondev-logo mx-5' src={LogoGif.src} /></a>
        </div>
        <div class="mx-5">
            <slot />
        </div>
    <!-- <Footer /> -->
  </body>
</html>
